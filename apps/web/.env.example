# Copy this file to apps/web/.env for LOCAL development; never commit .env
DATABASE_URL="postgresql://stepmark:CHANGE_ME@127.0.0.1:5432/stepmark"
# Optional: use a separate direct connection for migration jobs:
# DIRECT_URL="postgresql://stepmark_migrator:CHANGE_ME@127.0.0.1:5432/stepmark"
APP_ORIGIN="http://localhost:3000"
# For the actual production deployment ONLY (not local development):
# APP_ORIGIN="https://stepmark.xin"
# Must match the browser's canonical origin exactly; www.stepmark.xin is NOT
# interchangeable for cookie CSRF checks. Configure DNS/TLS/reverse proxy first.
# Generate independent, strong random values (at least 32 bytes); do NOT use this literal example.
RATE_LIMIT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_32_PLUS_BYTES"
DB_POOL_MAX="6"
# Needed for real public email registration/verification/password recovery.
# RESEND_API_KEY="..."
# AUTH_FROM_EMAIL="StepMark <no-reply@your-verified-domain.example>"
# Needed for mini-program login (server-only; never in mini-program config.js).
# WECHAT_APP_ID="..."
# WECHAT_APP_SECRET="..."
# ONLY if an ingress proxy strips and rewrites this header, e.g.:
# TRUSTED_CLIENT_IP_HEADER="x-real-ip"

# Optional, explicit opt-in external AI analysis of individual habit notes.
# AI_HABIT_PROVIDER="openai"   # openai | openrouter | deepseek | compatible
# AI_HABIT_API_KEY=""        # server-side secret, NEVER exposed to web/WeChat bundle
# AI_HABIT_MODEL=""          # verified JSON-output-capable model
# Run: npm run habits:analyze --workspace @stepmark/web (trusted scheduler)

# Optional server-only AI model for assistant chat.
# If these are unset, the already configured AI_HABIT_* settings are used.
# AI_ASSISTANT_PROVIDER="openai"  # openai | openrouter | deepseek | compatible
# AI_ASSISTANT_API_KEY="..."      # never commit or embed in WeChat config
# AI_ASSISTANT_MODEL="your-json-object-model"
# AI_ASSISTANT_DIGEST_SECRET="RANDOM_32_PLUS_BYTES" # optional; falls back to RATE_LIMIT_SECRET
# Schedule `npm run db:prune --workspace @stepmark/web` daily; replay receipts expire after 30 days.

# Optional server-only key for DeepSeek Flash growth plans and reviews.
# A configured DeepSeek assistant or habit API key also works here.
# DEEPSEEK_API_KEY=""

# Optional OpenAI-compatible third-party API, configured ONLY on the trusted server.
# For either purpose, set PROVIDER="compatible", ENDPOINT and ALLOWED_HOST together.
# AI_ASSISTANT_ENDPOINT="https://llm.example.com/v1/chat/completions"
# AI_ASSISTANT_ALLOWED_HOST="llm.example.com"
# AI_HABIT_ENDPOINT="https://llm.example.com/v1/chat/completions"
# AI_HABIT_ALLOWED_HOST="llm.example.com"
# The host must be public DNS, exactly allowlisted; HTTPS port 443 only.
# Never configure local network URLs, embed API keys in clients, or allow
# clients to choose upstream URLs. Restrict outbound network access at deployment.
