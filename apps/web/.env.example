# Copy this file to apps/web/.env for LOCAL development; never commit .env
DATABASE_URL="postgresql://stepmark:CHANGE_ME@127.0.0.1:5432/stepmark"
# Optional: use a separate direct connection for migration jobs:
# DIRECT_URL="postgresql://stepmark_migrator:CHANGE_ME@127.0.0.1:5432/stepmark"
APP_ORIGIN="http://localhost:3000"
# Generate independent, strong random values (at least 32 bytes); do NOT use this literal example.
RATE_LIMIT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_32_PLUS_BYTES"
DB_POOL_MAX="6"
# Needed for real public email registration/verification/password recovery.
# RESEND_API_KEY="..."
# AUTH_FROM_EMAIL="StepMark <no-reply@your-verified-domain.example>"
# Needed for mini-program login (server-only; never in mini-program config.js).
# WECHAT_APP_ID="..."
# WECHAT_APP_SECRET="..."
# ONLY if an ingress proxy strips and rewrites this header, e.g.:
# TRUSTED_CLIENT_IP_HEADER="x-real-ip"
