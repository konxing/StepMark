<view class="page">
  <view class="heading">STEP<text class="heading-mark">MARK.</text></view>
  <view class="overline">PERSONAL GROWTH RESEARCH</view>
  <view class="hero">让成长，<text>有迹可循。</text></view>
  <view class="description">习惯和能力分开测量。今天的执行记录，不代表能力自动增加。</view>
  <view class="note" aria-live="polite">{{status}}</view>
  <button wx:if="{{!authenticated}}" disabled="{{loading}}" bindtap="bootstrap" class="primary">连接我的账户</button>
  <block wx:if="{{authenticated}}">
    <view class="chat-card">
      <view class="chat-title">和 AI 聊聊今天的成长</view>
      <view class="chat-description">说出行动与感受，后端核对后自动记录；不确定时会先询问。</view>
      <scroll-view class="chat-feed" scroll-y="true" scroll-into-view="{{chatBottomId}}" enable-flex="true">
        <view wx:for="{{chatMessages}}" wx:key="id" id="{{item.id}}"
          class="chat-bubble {{item.role == 'user' ? 'chat-mine' : 'chat-ai'}}">
          <text selectable="true">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="chat-suggestions">
        <button wx:for="{{chatSuggestions}}" wx:key="*this" data-text="{{item}}"
          disabled="{{chatBusy}}" bindtap="chooseChatSuggestion">{{item}}</button>
      </view>
      <view class="chat-compose">
        <textarea value="{{chatInput}}" maxlength="600" auto-height="true"
          class="chat-textarea" bindinput="onChatInput"
          placeholder="今天做了什么？开始时是自然还是有点犹豫？"/>
        <button disabled="{{chatBusy || !chatInput}}" bindtap="sendChat" class="chat-send">
          {{chatBusy ? '处理…' : '发送'}}
        </button>
      </view>
      <view class="chat-consent">
        <switch checked="{{chatConsent}}" color="#317655" bindchange="onChatConsent"/>
        <text>同意将本次消息与习惯名称发送给配置的 AI 服务商，关闭则不发送。</text>
      </view>
      <text wx:if="{{chatStatus}}" class="chat-status">{{chatStatus}}</text>
      <text class="chat-hint">AI 只可记录明确的行为、感受及创建习惯，不能直接修改能力分。聊天消息仅保留在当前页面。</text>
    </view>
    <button class="advanced-toggle" bindtap="toggleAdvanced">
      {{showAdvanced ? '收起手动与专项功能' : '展开手动管理与专项训练'}}
    </button>

    <view wx:if="{{dueReviews.length>0}}" class="due-reviews">
      <view class="section-title">近期复查</view>
      <text class="meta">只是应用内提醒，不会因为偶尔漏做就扣除能力分。</text>
      <view wx:for="{{dueReviews}}" wx:key="habitId" class="due-review-item">
        <text>{{item.title}}</text>
        <button class="progress-button" data-id="{{item.habitId}}" bindtap="openProgress">快速复查</button>
      </view>
    </view>
    <block wx:if="{{showAdvanced}}">
    <view class="section-title">推理专项训练</view>
    <text class="meta">原创训练题与正式 A/B 卷完全分开，练习不会提升能力分数。</text>
    <button class="progress-button" bindtap="openPractice">
      {{practiceOpen ? '收起训练' : '开始 / 继续训练'}}
    </button>
    <view wx:if="{{practiceOpen}}" class="practice-card">
      <view class="practice-tabs">
        <button wx:for="{{practiceDomains}}" wx:key="code" data-skill="{{item.code}}"
          disabled="{{practiceBusy}}" bindtap="changePracticeSkill">
          {{item.label}}{{practiceRecommended == item.code ? ' · 推荐' : ''}}
        </button>
      </view>
      <text class="meta">{{practiceStatus}}</text>
      <view wx:if="{{practiceItem}}">
        <text class="practice-prompt">{{practiceItem.prompt}}</text>
        <radio-group bindchange="choosePracticeAnswer">
          <label wx:for="{{practiceItem.options}}" wx:for-item="choice" wx:key="key"
            class="practice-choice">
            <radio value="{{choice.key}}" checked="{{practiceSelected == choice.key}}"
              disabled="{{practiceBusy || practiceFeedback != null}}"/>
            <text>{{choice.key}}. {{choice.label}}</text>
          </label>
        </radio-group>
        <button wx:if="{{!practiceHintUsed && !practiceFeedback}}" class="progress-button"
          bindtap="showPracticeHint">需要提示</button>
        <text wx:if="{{practiceHintUsed}}" class="small-note">提示：{{practiceItem.hint}}</text>
        <text wx:if="{{practiceHintUsed}}" class="small-note">本次会标记为提示辅助练习。</text>
        <button wx:if="{{!practiceFeedback}}" class="primary" bindtap="submitPractice"
          disabled="{{practiceBusy || !practiceSelected}}">提交练习</button>
        <view wx:else class="practice-feedback">
          <text>{{practiceFeedback.correct ? '答对了' : '这次没有答对'}}</text>
          <text>你的选择：{{practiceFeedback.selectedKey}}；正确选项：{{practiceFeedback.answerKey}}</text>
          <text>{{practiceFeedback.explanation}}</text>
          <text class="small-note">{{practiceFeedback.hintUsed == false ? '独立提取练习（未查看提示）' : '提示辅助或来源未知的练习'}}</text>
          <button class="progress-button" disabled="{{practiceBusy}}" bindtap="nextPractice">下一道练习</button>
        </view>
      </view>
      <text wx:if="{{!practiceItem && practiceNextReviewUtc}}" class="small-note">
        该类别下一次建议复习：{{practiceNextReviewUtc}}
      </text>
      <text class="small-note">复习间隔属于可调整的产品策略，不代表个人能力概率。</text>
    </view>
    </block>
    <view class="section-title">我的习惯</view>
    <view wx:if="{{modules.length===0}}" class="empty">还没有习惯，创建一个可观察的微型行动吧。</view>
    <view class="cards">
      <view wx:for="{{modules}}" wx:key="id" class="card">
        <text class="title">{{item.title}}</text>
        <text class="meta">{{item.action}}</text>
        <text wx:if="{{item.cue}}" class="meta">触发情境：{{item.cue}}</text>
        <text class="meta">已记录天数：{{item._count.events}}</text>
        <button wx:if="{{showAdvanced}}" class="primary" data-id="{{item.id}}" data-kind="done" disabled="{{creating}}" bindtap="record">今天已执行</button>
        <view wx:if="{{showAdvanced}}" class="opportunity-row">
          <button data-id="{{item.id}}" data-kind="missed" disabled="{{creating}}" bindtap="record">有机会，没执行</button>
          <button data-id="{{item.id}}" data-kind="no_cue" disabled="{{creating}}" bindtap="record">今天没机会</button>
        </view>
        <button class="progress-button" data-id="{{item.id}}" bindtap="openProgress">查看习惯进度</button>
      </view>
    </view>
    <view wx:if="{{selectedHabitId && progress}}" class="progress-card">
      <view class="section-title">习惯形成进度</view>
      <view class="progress-percentage">{{progress.progress}}%</view>
      <view class="progress-track"><view class="progress-fill" style="width:{{progress.progress}}%;"></view></view>
      <text class="meta">已执行 {{progress.completedRepetitions}} 次，感受证据 {{progress.evidenceCount}} 条</text>
      <view wx:if="{{progress.evidenceStale}}" class="review-note">
        最近 45 天没有新的有效感受评分。显示的是历史证据支持的进度，不代表当前状态；缺少记录不扣分。
      </view>
      <view wx:if="{{progress.reviewDue}}" class="review-note">该复查了：现在开始这个习惯仍然自然吗？</view>
      <view class="small-note">百分比是实验性成长指标，不是习惯形成概率，也不直接增加能力分。</view>
      <block wx:if="{{showAdvanced}}">
      <view class="section-title">最近记录 · 更正</view>
      <view wx:for="{{recentEvents}}" wx:key="id" class="reflection-item">
        <text class="meta">{{item.opportunityKey}} · {{!item.eligible ? '没有触发机会' : (item.completed ? '已执行' : '有机会未执行')}} · 版本 {{item.revision}}</text>
        <view class="opportunity-row">
          <button data-id="{{item.id}}" data-kind="done" disabled="{{correcting}}" bindtap="correctOpportunity">改为已执行</button>
          <button data-id="{{item.id}}" data-kind="missed" disabled="{{correcting}}" bindtap="correctOpportunity">改为未执行</button>
          <button data-id="{{item.id}}" data-kind="no_cue" disabled="{{correcting}}" bindtap="correctOpportunity">改为无机会</button>
        </view>
        <button wx:if="{{item.revision > 0}}" class="progress-button"
          data-id="{{item.id}}" disabled="{{auditLoading}}" bindtap="toggleAuditHistory">
          {{auditEventId == item.id ? '收起更正历史' : '查看更正历史'}}
        </button>
        <view wx:if="{{auditEventId == item.id}}" class="recent-reflections">
          <view wx:for="{{auditRows}}" wx:for-item="correction" wx:key="id" class="reflection-item">
            <text class="meta">版本 {{correction.revision}} · {{correction.dateLabel}}</text>
            <text class="meta">{{correction.beforeLabel}} → {{correction.afterLabel}}</text>
          </view>
          <button wx:if="{{auditNextOffset != null}}" class="progress-button"
            disabled="{{auditLoading}}" bindtap="loadMoreAudit">加载更多历史</button>
        </view>
      </view>
      <text class="meta">更正将留下历史；关联感受的执行记录需要先处理感受记录。</text>
      </block>
      <block wx:if="{{showAdvanced}}">
      <view class="section-title">手动记录行动感受（备用）</view>
      <picker range="{{feelingOptions}}" value="{{feelIndex == -1 ? 0 : feelIndex}}" bindchange="chooseFeeling">
        <view class="picker-control">{{feelIndex == -1 ? '选择最接近的感受' : feelingOptions[feelIndex]}}</view>
      </picker>
      <textarea maxlength="600" class="feedback-note" value="{{feedbackNote}}" bindinput="updateFeelingNote"
        placeholder="例如：这次看到提示就自然开始了，没有思考。"></textarea>
      <view class="ai-consent-row">
        <switch checked="{{aiConsent}}" disabled="{{!feedbackNote}}" bindchange="setAiConsent" color="#347856"/>
        <text>同意将当前文字发送给 AI 服务商分析（默认关闭）</text>
      </view>
      <button class="primary" disabled="{{creating || (!feedbackNote && feelIndex == -1)}}" bindtap="saveReflection">保存感受</button>
      </block>
      <button class="progress-button" data-id="{{selectedHabitId}}" bindtap="toggleReview">
        切换当前习惯复查提示
      </button>
      <view wx:if="{{recentReflections.length>0}}" class="recent-reflections">
        <view class="section-title">我的近期感受</view>
        <view wx:for="{{recentReflections}}" wx:key="id" class="reflection-item">
          <text class="meta">{{item.note || '已记录一次自然启动等级'}}</text>
          <text wx:if="{{item.aiConsent}}" class="meta">AI 状态：{{item.aiStatusLabel}}</text>
          <view class="reflection-actions">
            <button wx:if="{{item.aiConsent}}" data-id="{{item.id}}" data-action="revoke"
              disabled="{{creating}}" bindtap="controlReflection">撤回 AI 授权</button>
            <button data-id="{{item.id}}" data-action="delete"
              disabled="{{creating}}" bindtap="controlReflection">删除感受</button>
          </view>
        </view>
        <view class="small-note">已发送给第三方的文字不能远程收回；处理中可能暂时无法取消。</view>
      </view>
    </view>
    <block wx:if="{{showAdvanced}}">
    <view class="section-title">手动添加习惯（备用）</view>
    <view class="form">
      <input maxlength="180" value="{{title}}" bindinput="updateTitle" placeholder="习惯名称"/>
      <textarea maxlength="500" value="{{action}}" bindinput="updateAction" placeholder="具体行动"/>
      <input maxlength="250" value="{{cue}}" bindinput="updateCue" placeholder="触发情境（选填）"/>
      <button class="primary" disabled="{{creating}}" bindtap="createHabit">保存习惯</button>
    </view>
    </block>
    <button class="logout" bindtap="logout">退出登录</button>
  </block>
</view>
