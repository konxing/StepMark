.page{padding:48rpx 40rpx 100rpx}.heading{font-weight:900;font-size:44rpx;letter-spacing:-2rpx}.heading span{color:#5a9876}.overline{font-size:19rpx;color:#648a72;letter-spacing:3rpx;margin-top:96rpx}.hero{font-size:66rpx;font-weight:800;line-height:1.3;margin-top:24rpx}.hero text{color:#619a77}.description{color:#75877a;font-size:27rpx;line-height:1.8;margin-top:32rpx}.note{font-size:22rpx;color:#557260;background:#e8eee7;padding:24rpx;border-radius:12rpx;margin-top:30rpx}.section-title{font-size:33rpx;font-weight:700;margin:55rpx 0 25rpx}.cards{display:flex;flex-direction:column;gap:22rpx}.card{padding:30rpx;background:white;border:1rpx solid #dee9dd;border-radius:18rpx;display:flex;flex-direction:column;gap:13rpx}.title{font-size:31rpx;font-weight:700}.meta{font-size:24rpx;color:#839087}.empty{font-size:25rpx;color:#839087;margin-bottom:25rpx}.primary{background:#173a2c;color:white;font-size:26rpx;border-radius:12rpx;margin-top:18rpx}.form{display:flex;flex-direction:column;gap:20rpx}.form input,.form textarea{box-sizing:border-box;background:white;border:1rpx solid #dae4d9;border-radius:10rpx;padding:20rpx;width:100%;font-size:26rpx}.form textarea{height:150rpx}.logout{margin-top:60rpx;border:0;background:none;color:#607c68;font-size:23rpx}

.progress-button{border:1rpx solid #c3d8c7;background:white;color:#39694b;font-size:24rpx;margin-top:15rpx}
.progress-card{margin-top:40rpx;background:white;padding:28rpx;border-radius:18rpx}
.progress-card .section-title{margin:30rpx 0 18rpx}
.progress-percentage{font-size:60rpx;font-weight:bold;color:#387e59}
.progress-track{height:23rpx;background:#e3efe5;border-radius:20rpx;margin:16rpx 0;overflow:hidden}
.progress-fill{height:100%;background:#55a077;border-radius:inherit}
.review-note{margin:25rpx 0;padding:16rpx;background:#eaf3ed;color:#2c6c4b}
.small-note{font-size:21rpx;color:#6c8578;line-height:1.6;margin-top:20rpx}
.picker-control{border:1rpx solid #cedfd0;padding:23rpx;border-radius:12rpx;color:#406750;font-size:26rpx}
.feedback-note{box-sizing:border-box;border:1rpx solid #cedfd0;width:100%;padding:22rpx;margin-top:18rpx;border-radius:10rpx;height:160rpx;font-size:26rpx}
.ai-consent-row{display:flex;align-items:center;gap:15rpx;font-size:21rpx;color:#657b70;margin-top:18rpx;line-height:1.5}

.opportunity-row{display:flex;gap:12rpx}.opportunity-row button{flex:1;font-size:21rpx;color:#44715a;background:#edf4ed;line-height:1.35;padding:15rpx 5rpx}

.due-reviews{margin-top:35rpx;border:1rpx solid #dce8dc;background:#f5f9f4;padding:25rpx;border-radius:15rpx}.due-reviews .section-title{margin:10rpx 0 16rpx}.due-review-item{border-top:1rpx solid #e0ece0;margin-top:16rpx;padding-top:13rpx;display:flex;justify-content:space-between;align-items:center;gap:15rpx}.due-review-item text{font-size:25rpx}.due-review-item button{margin:0;flex-shrink:0;font-size:21rpx}

.recent-reflections{border-top:1rpx solid #dce7dc;margin-top:38rpx;padding-top:10rpx}.reflection-item{border-top:1rpx solid #edf1ec;padding:23rpx 0;display:flex;flex-direction:column;gap:12rpx}.reflection-item text{white-space:pre-wrap;word-break:break-all}.reflection-actions{display:flex;gap:10rpx}.reflection-actions button{flex:1;font-size:21rpx;color:#4b7458;background:#ecf3ed;border-radius:10rpx;margin:0;padding:8rpx 6rpx}

/* Optional independent reasoning practice; no extra API calls on page load. */
.practice-card{padding:27rpx;margin-top:15rpx;border:1rpx solid #dce6da;border-radius:16rpx;background:#fff}
.practice-tabs{display:flex;gap:9rpx;flex-wrap:wrap;margin-bottom:25rpx}
.practice-tabs button{font-size:21rpx;background:#edf4ee;color:#2b5d40;padding:9rpx;margin:0}
.practice-prompt{display:block;margin:23rpx 0;font-size:27rpx;font-weight:600;line-height:1.7}
.practice-choice{display:flex;gap:13rpx;align-items:flex-start;padding:20rpx 10rpx;border-top:1rpx solid #e4eee4;font-size:24rpx}
.practice-choice radio{flex-shrink:0}
.practice-choice text{flex:1;line-height:1.6}
.practice-feedback{display:flex;flex-direction:column;gap:15rpx;padding:21rpx;margin-top:16rpx;border-radius:12rpx;background:#eff7f0;font-size:24rpx;color:#315b3c;line-height:1.65}
.practice-feedback button{margin-top:15rpx}
