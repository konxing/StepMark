.page{padding:48rpx 40rpx 100rpx}.heading{font-weight:900;font-size:44rpx;letter-spacing:-2rpx}.heading-mark{color:#5a9876}.overline{font-size:19rpx;color:#648a72;letter-spacing:3rpx;margin-top:96rpx}.hero{font-size:66rpx;font-weight:800;line-height:1.3;margin-top:24rpx}.hero text{color:#619a77}.description{color:#75877a;font-size:27rpx;line-height:1.8;margin-top:32rpx}.note{font-size:22rpx;color:#557260;background:#e8eee7;padding:24rpx;border-radius:12rpx;margin-top:30rpx}.section-title{font-size:33rpx;font-weight:700;margin:55rpx 0 25rpx}.cards{display:flex;flex-direction:column;gap:22rpx}.card{padding:30rpx;background:white;border:1rpx solid #dee9dd;border-radius:18rpx;display:flex;flex-direction:column;gap:13rpx}.title{font-size:31rpx;font-weight:700}.meta{font-size:24rpx;color:#839087}.empty{font-size:25rpx;color:#839087;margin-bottom:25rpx}.primary{background:#173a2c;color:white;font-size:26rpx;border-radius:12rpx;margin-top:18rpx}.form{display:flex;flex-direction:column;gap:20rpx}.form input,.form textarea{box-sizing:border-box;background:white;border:1rpx solid #dae4d9;border-radius:10rpx;padding:20rpx;width:100%;font-size:26rpx}.form textarea{height:150rpx}.logout{margin-top:60rpx;border:0;background:none;color:#607c68;font-size:23rpx}

.progress-button{border:1rpx solid #c3d8c7;background:white;color:#39694b;font-size:24rpx;margin-top:15rpx}
.progress-card{margin-top:40rpx;background:white;padding:28rpx;border-radius:18rpx}
.progress-card .section-title{margin:30rpx 0 18rpx}
.progress-percentage{font-size:60rpx;font-weight:bold;color:#387e59}
.progress-track{height:23rpx;background:#e3efe5;border-radius:20rpx;margin:16rpx 0;overflow:hidden}
.progress-fill{height:100%;background:#55a077;border-radius:inherit}
.review-note{margin:25rpx 0;padding:16rpx;background:#eaf3ed;color:#2c6c4b}
.small-note{font-size:21rpx;color:#6c8578;line-height:1.6;margin-top:20rpx}
.picker-control{border:1rpx solid #cedfd0;padding:23rpx;border-radius:12rpx;color:#406750;font-size:26rpx}
.feedback-note{box-sizing:border-box;border:1rpx solid #cedfd0;width:100%;padding:22rpx;margin-top:18rpx;border-radius:10rpx;height:160rpx;font-size:26rpx}
.ai-consent-row{display:flex;align-items:center;gap:15rpx;font-size:21rpx;color:#657b70;margin-top:18rpx;line-height:1.5}

.opportunity-row{display:flex;gap:12rpx}.opportunity-row button{flex:1;font-size:21rpx;color:#44715a;background:#edf4ed;line-height:1.35;padding:15rpx 5rpx}

.due-reviews{margin-top:35rpx;border:1rpx solid #dce8dc;background:#f5f9f4;padding:25rpx;border-radius:15rpx}.due-reviews .section-title{margin:10rpx 0 16rpx}.due-review-item{border-top:1rpx solid #e0ece0;margin-top:16rpx;padding-top:13rpx;display:flex;justify-content:space-between;align-items:center;gap:15rpx}.due-review-item text{font-size:25rpx}.due-review-item button{margin:0;flex-shrink:0;font-size:21rpx}

.recent-reflections{border-top:1rpx solid #dce7dc;margin-top:38rpx;padding-top:10rpx}.reflection-item{border-top:1rpx solid #edf1ec;padding:23rpx 0;display:flex;flex-direction:column;gap:12rpx}.reflection-item text{white-space:pre-wrap;word-break:break-all}.reflection-actions{display:flex;gap:10rpx}.reflection-actions button{flex:1;font-size:21rpx;color:#4b7458;background:#ecf3ed;border-radius:10rpx;margin:0;padding:8rpx 6rpx}

/* Optional independent reasoning practice; no extra API calls on page load. */
.practice-card{padding:27rpx;margin-top:15rpx;border:1rpx solid #dce6da;border-radius:16rpx;background:#fff}
.practice-tabs{display:flex;gap:9rpx;flex-wrap:wrap;margin-bottom:25rpx}
.practice-tabs button{font-size:21rpx;background:#edf4ee;color:#2b5d40;padding:9rpx;margin:0}
.practice-prompt{display:block;margin:23rpx 0;font-size:27rpx;font-weight:600;line-height:1.7}
.practice-choice{display:flex;gap:13rpx;align-items:flex-start;padding:20rpx 10rpx;border-top:1rpx solid #e4eee4;font-size:24rpx}
.practice-choice radio{flex-shrink:0}
.practice-choice text{flex:1;line-height:1.6}
.practice-feedback{display:flex;flex-direction:column;gap:15rpx;padding:21rpx;margin-top:16rpx;border-radius:12rpx;background:#eff7f0;font-size:24rpx;color:#315b3c;line-height:1.65}
.practice-feedback button{margin-top:15rpx}

/* Mobile-first chat with bounded message viewport and safe-area padding. */
page{width:100%;overflow-x:hidden;background:#f5f6f2}
.page{box-sizing:border-box;width:100%;min-width:0;max-width:100vw;
  padding:30rpx 30rpx calc(90rpx + env(safe-area-inset-bottom));overflow-x:hidden}
.page .overline{margin-top:34rpx}
.page .hero{font-size:52rpx;margin-top:15rpx}
.page .description{margin-top:14rpx;line-height:1.65}
.page .note{margin-top:18rpx;padding:14rpx 18rpx;overflow-wrap:anywhere}
.page view,.page text,.page textarea,.page button{box-sizing:border-box;max-width:100%}
.page button{white-space:normal;overflow-wrap:anywhere;min-width:0}
.chat-card{background:#fff;border:1rpx solid #d9e8dc;border-radius:22rpx;
  margin:24rpx 0 24rpx;padding:24rpx;min-width:0}
.chat-title{font-size:34rpx;font-weight:800;color:#163f2a}
.chat-description{font-size:23rpx;color:#6c8173;line-height:1.65;margin:9rpx 0 22rpx}
.chat-feed{height:470rpx;max-height:45vh;width:100%;padding:18rpx;
  background:#f5f9f4;border:1rpx solid #e1ebdf;border-radius:15rpx}
.chat-bubble{display:block;width:fit-content;max-width:87%;padding:15rpx 20rpx;
  margin:0 0 18rpx;line-height:1.65;font-size:26rpx;
  border-radius:18rpx;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-all}
.chat-ai{background:#fff;color:#355842;border:1rpx solid #dce9de}
.chat-mine{background:#245d40;color:#fff;margin-left:auto}
.chat-suggestions{display:flex;flex-wrap:wrap;gap:9rpx;margin:20rpx 0}
.chat-suggestions button{background:#edf6ed;color:#366c4e;border:1rpx solid #d5e7d7;
  border-radius:25rpx;padding:12rpx 17rpx;margin:0;
  font-size:22rpx;line-height:1.45;text-align:left}
.chat-compose{display:flex;align-items:stretch;gap:12rpx;width:100%}
.chat-textarea{box-sizing:border-box;flex:1;width:0;min-width:0;min-height:110rpx;
  max-height:220rpx;padding:15rpx;background:#fff;border:1rpx solid #b9d1bf;
  border-radius:12rpx;font-size:27rpx;line-height:1.5}
.chat-send{flex:0 0 130rpx;width:130rpx;margin:0;padding:15rpx 7rpx;
  border:0;border-radius:12rpx;color:#fff;background:#194632;
  font-size:25rpx;min-height:100rpx;line-height:1.55}
.chat-consent{display:flex;align-items:flex-start;gap:15rpx;margin:20rpx 0 12rpx;
  color:#516d5d;font-size:23rpx;line-height:1.6}
.chat-consent switch{flex-shrink:0;transform:scale(.85);transform-origin:top left}
.chat-consent text{flex:1;min-width:0;overflow-wrap:anywhere}
.chat-status{display:block;color:#a03f33;font-size:23rpx;line-height:1.6;margin:12rpx 0}
.chat-hint{display:block;color:#75877b;font-size:20rpx;line-height:1.65;margin-top:12rpx}
.advanced-toggle{margin:12rpx 0 20rpx;border:1rpx solid #ccddcf;background:#fff;
  color:#346b4c;border-radius:13rpx;font-size:24rpx;padding:12rpx}
.card,.progress-card,.practice-card,.due-reviews{min-width:0;overflow-wrap:anywhere}
.card .primary,.progress-card .primary{min-height:79rpx}
.opportunity-row button,.reflection-actions button{min-height:76rpx;
  font-size:23rpx;line-height:1.45;word-break:break-word}
.practice-tabs button{min-height:70rpx}
