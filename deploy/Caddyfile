# Initial rollout: DNS-only (direct clients -> Caddy -> private Next.js).
# Caddy is the ONLY public ingress. Never expose web:3000 directly.
# When enabling a CDN/proxy, the TCP peer becomes the CDN edge; update the
# trusted-proxy chain and test real visitor-IP attribution BEFORE enabling it.
stepmark.xin {
  encode zstd gzip

  # Small JSON APIs only. Reject oversized requests before they reach Node.
  request_body {
    max_size 64KB
  }

  reverse_proxy web:3000 {
    # Overwrite any attacker-supplied header using the direct TCP peer.
    # Never forward an unverified CF-Connecting-IP header to the application.
    header_up X-Real-IP {remote_host}
    header_up -CF-Connecting-IP
  }
}
