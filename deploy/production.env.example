# Copy to deploy/production.env on the server. NEVER commit the real file.
# Docker Compose overrides APP_ORIGIN to https://stepmark.xin.
# Use a PostgreSQL instance in the same Alibaba Cloud region as ECS.
# Require TLS for any non-local managed database connection as configured
# by your provider. Do not copy this placeholder password into production.
DATABASE_URL=postgresql://stepmark_app:REPLACE_ME@postgres-private-host:5432/stepmark?sslmode=require
# Generate a fresh 32-byte base64url secret with Node's crypto.randomBytes(32).
# The production web service refuses to start with this placeholder.
RATE_LIMIT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_PLUS_BYTES
DB_POOL_MAX=6

# Optional server-only key for DeepSeek Flash. Habit analysis also requires its scheduled worker.
# DEEPSEEK_API_KEY=REPLACE_ME

# You MUST configure at least one sign-in channel (email OR WeChat).
# For website registration, password reset and Windows browser authorization,
# configure a verified email sender; WeChat-only does NOT enable web logins.
# Configure a verified sender before allowing public account registration:
# RESEND_API_KEY=REPLACE_ME
# AUTH_FROM_EMAIL=StepMark <no-reply@stepmark.xin>

# Optional WeChat mini-program integration; secrets are server-only:
# WECHAT_APP_ID=REPLACE_ME
# WECHAT_APP_SECRET=REPLACE_ME

# Compose configures a trusted x-real-ip header internally. The included Caddyfile
# overwrites X-Real-IP with the direct TCP peer and strips CF-Connecting-IP.
# Do not override this on a directly exposed Node server. If enabling Cloudflare
# proxy mode, first implement and test trusted CDN IP forwarding: otherwise all
# visitors behind a Cloudflare edge may share one rate-limit bucket.
